# Cloudflare stack: applied FROM YOUR LAPTOP, not from GitHub Actions.
#
# Why: Cloudflare cannot trust GitHub's OIDC identity the way AWS can, so automating this
# stack would mean storing a long-lived Cloudflare API token in GitHub. Keeping it local
# means the pipeline holds no static secret at all. This stack changes rarely (DNS and
# firewall settings), so the manual step costs little.
#
# Auth:  export CLOUDFLARE_API_TOKEN=...   (scope: Zone:DNS:Edit, Zone:Zone Settings:Edit,
#        Zone:Transform Rules:Edit, Zone:Cache Rules:Edit, limited to ONE zone)
#        plus normal AWS credentials to read the AWS stack's remote state.

terraform {
  required_version = ">= 1.10"

  required_providers {
    cloudflare = {
      source  = "cloudflare/cloudflare"
      version = "~> 4.52"
    }
  }

  backend "s3" {
    key          = "cloudflare/terraform.tfstate"
    encrypt      = true
    use_lockfile = true
  }
}

provider "cloudflare" {}

variable "region" {
  type    = string
  default = "us-east-1"
}

variable "state_bucket" {
  description = "Name of the Terraform state bucket created by bootstrap."
  type        = string
}

data "terraform_remote_state" "aws" {
  backend = "s3"
  config = {
    bucket = var.state_bucket
    key    = "aws/terraform.tfstate"
    region = var.region
  }
}

locals {
  aws        = data.terraform_remote_state.aws.outputs
  domain     = local.aws.domain_name
  stage      = local.aws.domain_stage
  live       = local.stage == "live"
  validation = local.aws.acm_validation_records
}

data "cloudflare_zone" "this" {
  name = local.domain
}

# ------------------------------------------------------------ Certificate validation (stage cert and live)
# DNS only (not proxied): ACM must be able to see these records directly.

resource "cloudflare_record" "acm_validation" {
  for_each = local.validation

  zone_id = data.cloudflare_zone.this.id
  name    = trimsuffix(each.value.name, ".")
  type    = each.value.type
  content = trimsuffix(each.value.value, ".")
  ttl     = 300
  proxied = false
}

# ------------------------------------------------------------ Site records (stage live only)

resource "cloudflare_record" "apex" {
  count = local.live ? 1 : 0

  zone_id = data.cloudflare_zone.this.id
  name    = "@"
  type    = "CNAME" # Cloudflare flattens apex CNAMEs
  content = local.aws.distribution_domain_name
  proxied = true
  ttl     = 1
}

resource "cloudflare_record" "www" {
  count = local.live ? 1 : 0

  zone_id = data.cloudflare_zone.this.id
  name    = "www"
  type    = "CNAME"
  content = local.aws.distribution_domain_name
  proxied = true
  ttl     = 1
}

# ------------------------------------------------------------ TLS and protection settings

resource "cloudflare_zone_settings_override" "this" {
  count   = local.live ? 1 : 0
  zone_id = data.cloudflare_zone.this.id

  settings {
    ssl                      = "strict" # Cloudflare verifies CloudFront's ACM certificate
    always_use_https         = "on"
    min_tls_version          = "1.2"
    tls_1_3                  = "on"
    automatic_https_rewrites = "on"
  }
}

# ------------------------------------------------------------ The secret header

# Adds x-origin-verify to every request Cloudflare forwards to CloudFront. The value comes
# from the AWS stack's state (generated by Terraform, never typed by a human). Order of
# operations: apply this first, confirm the site still works, THEN set
# enforce_origin_secret = true in the AWS stack.
resource "cloudflare_ruleset" "origin_header" {
  count = local.live ? 1 : 0

  zone_id     = data.cloudflare_zone.this.id
  name        = "Add origin verification header"
  description = "Lets CloudFront reject requests that did not come through Cloudflare"
  kind        = "zone"
  phase       = "http_request_late_transform"

  rules {
    action      = "rewrite"
    expression  = "true"
    description = "Set x-origin-verify"
    enabled     = true

    action_parameters {
      headers {
        name      = "x-origin-verify"
        operation = "set"
        value     = local.aws.origin_verify_secret
      }
    }
  }
}

# CloudFront is the only cache. Cloudflare caching on top would hide CloudFront invalidations.
resource "cloudflare_ruleset" "cache_bypass" {
  count = local.live ? 1 : 0

  zone_id     = data.cloudflare_zone.this.id
  name        = "Bypass Cloudflare cache"
  description = "CloudFront is the only cache in the chain"
  kind        = "zone"
  phase       = "http_request_cache_settings"

  rules {
    action      = "set_cache_settings"
    expression  = "true"
    description = "No Cloudflare caching"
    enabled     = true

    action_parameters {
      cache = false
    }
  }
}
