// CloudFront Function (viewer-request). Runs on every request, before the cache.
//
// 1. Origin check: when enforcement is on, only requests carrying the secret header that
//    Cloudflare adds are allowed. Anyone hitting the raw *.cloudfront.net address gets 403.
// 2. URL rewrite: S3 has no "folder index", so /projects/ becomes /projects/index.html.
//
// The secret is generated by Terraform and rendered into this file at apply time.
// It is not in the repo. Anyone with read access to this AWS account can see it in the
// console, so treat it as a deterrent against bypassing Cloudflare, not as a vault.

function handler(event) {
  var request = event.request;

  if ("${enforce}" === "true") {
    var header = request.headers["x-origin-verify"];
    if (!header || header.value !== "${secret}") {
      return {
        statusCode: 403,
        statusDescription: "Forbidden",
        headers: { "cache-control": { value: "no-store" } }
      };
    }
  }

  var uri = request.uri;
  if (uri.endsWith("/")) {
    request.uri = uri + "index.html";
  } else if (uri.indexOf(".") === -1) {
    request.uri = uri + "/index.html";
  }

  return request;
}
