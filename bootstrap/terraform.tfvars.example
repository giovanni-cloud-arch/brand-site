# Copy to terraform.tfvars (git-ignored) and fill in.
github_owner = "YOUR-GITHUB-USERNAME"
github_repo  = "brand-site"
region       = "us-east-1"
project      = "brand-site"

# Numeric IDs GitHub puts in the OIDC subject (repos created after 2026-07-15).
# If the first pipeline run fails with "Not authorized to perform sts:AssumeRoleWithWebIdentity",
# find them in CloudTrail (userName of the failed AssumeRoleWithWebIdentity event):
#   repo:<owner>@<owner_id>/<repo>@<repo_id>:ref:refs/heads/main
github_owner_id = "12345678"
github_repo_id  = "123456789"

# Set to false if `aws iam list-open-id-connect-providers` already shows
# token.actions.githubusercontent.com in this account.
create_oidc_provider = true
