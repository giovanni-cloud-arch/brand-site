<mxfile host="app.diagrams.net">
  <diagram id="arch" name="Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b&gt;Personal brand site - architecture&lt;/b&gt;&lt;br&gt;Placeholder domain: example.com. Until a real domain exists the site is served from the default *.cloudfront.net URL (domain_stage = none). Three Terraform stacks: bootstrap (laptop, once), infra/aws (GitHub Actions via OIDC), infra/cloudflare (laptop, no Cloudflare token in GitHub). The x-origin-verify secret is generated by Terraform in the AWS stack and read by the Cloudflare stack from remote state." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1100" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="cfbox" value="Cloudflare (protection only)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="200" y="120" width="240" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="cf_dns" value="DNS records (proxied)&lt;br&gt;example.com, www" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="220" y="170" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="cf_waf" value="WAF + bot protection&lt;br&gt;TLS mode: Full (strict)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="220" y="250" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="cf_cache" value="Cache bypass rule (CloudFront is the only cache)&lt;br&gt;Transform Rule adds header x-origin-verify" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="220" y="330" width="200" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="visitor" value="Visitor (browser)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry x="75" y="230" width="40" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="awsbox" value="AWS account" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="490" y="120" width="860" height="560" as="geometry"/>
        </mxCell>
        <mxCell id="cfn" value="&lt;b&gt;CloudFront&lt;/b&gt;&lt;br&gt;CDN, HTTPS, HTTP/2 and 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="520" y="170" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="cff" value="CloudFront Function&lt;br&gt;1) header wrong or missing: 403 (when enforced)&lt;br&gt;2) /path to /path/index.html" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="520" y="270" width="170" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="rhp" value="Response headers policy&lt;br&gt;HSTS, CSP, nosniff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="520" y="340" width="170" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="acm" value="ACM certificate&lt;br&gt;us-east-1, DNS-validated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="520" y="420" width="170" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="s3site" value="&lt;b&gt;S3 bucket: site&lt;/b&gt;&lt;br&gt;private, versioned, encrypted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="760" y="170" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="oac" value="OAC (Origin Access Control)&lt;br&gt;bucket policy: CloudFront only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="760" y="270" width="170" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="budget" value="AWS Budget alert&lt;br&gt;(optional, low threshold)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="420" width="170" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="s3state" value="&lt;b&gt;S3 bucket: tfstate&lt;/b&gt;&lt;br&gt;versioned, encrypted, lockfile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1000" y="170" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="oidc" value="IAM OIDC provider&lt;br&gt;token.actions.githubusercontent.com" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1000" y="300" width="170" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="rolesite" value="Role: site-deploy&lt;br&gt;s3 sync + invalidation only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1000" y="390" width="170" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="roleinfra" value="Role: infra (Terraform)&lt;br&gt;plan on PR, apply on main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1000" y="480" width="170" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="ghbox" value="GitHub" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="400" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="repo" value="&lt;b&gt;Repo: brand-site&lt;/b&gt;&lt;br&gt;/site  /infra  /.github&lt;br&gt;branch protection on main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="wf1" value="deploy-site.yml&lt;br&gt;build, sync, invalidate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="250" y="520" width="170" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="wf2" value="infra.yml&lt;br&gt;fmt, validate, checkov, plan, apply" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="250" y="600" width="170" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="e1" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="visitor" target="cf_waf">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="HTTPS to origin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="cf_waf" target="cfn">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="signed GET (OAC)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="cfn" target="s3site">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="viewer cert" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="acm" target="cfn">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="oac" target="s3site">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="repo" target="wf1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="repo" target="wf2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="OIDC token, short-lived creds" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="wf1" target="rolesite">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9" value="OIDC token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="wf2" target="roleinfra">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e10" value="trust" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="oidc" target="rolesite">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e11" value="remote state" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="roleinfra" target="s3state">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="cicd" name="CI-CD flow">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="t2" value="&lt;b&gt;CI/CD flow&lt;/b&gt; - every change, content or infrastructure, goes through a pull request" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1000" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="p_local" value="Edit in a branch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="130" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p_pr" value="Open pull request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="210" y="200" width="130" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s_chk" value="site/** changed:&lt;br&gt;build, HTML and link check&lt;br&gt;(no deploy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="400" y="90" width="230" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="i_chk" value="infra/** changed:&lt;br&gt;fmt, validate, tflint, Checkov,&lt;br&gt;terraform plan posted to the PR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="400" y="290" width="230" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p_merge" value="Review + merge to main&lt;br&gt;(branch protection: checks must pass)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="680" y="190" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s_dep" value="deploy-site.yml (site-deploy role):&lt;br&gt;build, s3 sync, CloudFront invalidation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="900" y="90" width="250" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="i_app" value="infra.yml on main:&lt;br&gt;plan job saves plan to private S3,&lt;br&gt;you approve in Environment production,&lt;br&gt;apply job runs that exact plan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="900" y="290" width="250" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="live" value="Live site" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1190" y="195" width="110" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="Rollback: revert the commit on main and the pipeline redeploys. S3 versioning keeps previous objects; Terraform state is versioned too." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="400" y="440" width="750" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="p_local" target="p_pr">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="p_pr" target="s_chk">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="p_pr" target="i_chk">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="s_chk" target="p_merge">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="i_chk" target="p_merge">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="p_merge" target="s_dep">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="p_merge" target="i_app">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="s_dep" target="live">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f9" value="updates infra" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="i_app" target="live">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
